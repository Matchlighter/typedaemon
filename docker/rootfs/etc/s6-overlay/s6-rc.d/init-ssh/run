#!/command/with-contenv sh
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Advanced SSH & Web Terminal
# Configures the SSH daemon
# ==============================================================================
readonly SSH_AUTHORIZED_KEYS_PATH=/etc/ssh/authorized_keys
readonly SSH_CONFIG_PATH=/etc/ssh/sshd_config
readonly SSH_HOST_ED25519_KEY="$TYPEDAEMON_CONFIG/.typedaemon/ssh_host_ed25519_key"
readonly SSH_HOST_RSA_KEY="$TYPEDAEMON_CONFIG/.typedaemon/ssh_host_rsa_key"
# declare password
# declare username

username=root

if [ ! -f "$SSH_HOST_RSA_KEY" ]; then
    ssh-keygen -t rsa -f "${SSH_HOST_RSA_KEY}" -N ""
fi
cp "${SSH_HOST_RSA_KEY}" "/etc/ssh/ssh_host_rsa_key"
cp "${SSH_HOST_RSA_KEY}.pub" "/etc/ssh/ssh_host_rsa_key.pub"

if [ ! -f "$SSH_HOST_ED25519_KEY" ]; then
    ssh-keygen -t ed25519 -f "${SSH_HOST_ED25519_KEY}" -N ""
fi
cp "${SSH_HOST_ED25519_KEY}" "/etc/ssh/ssh_host_ed25519_key"
cp "${SSH_HOST_ED25519_KEY}.pub" "/etc/ssh/ssh_host_ed25519_key.pub"


# username=$(bashio::config 'ssh.username')
# username=$(bashio::string.lower "${username}")

# # We need to set a password for the user account
# if bashio::config.has_value 'ssh.password'; then
#     password=$(bashio::config 'ssh.password')
# else
#     # Use a random password in case none is set
#     password=$(pwgen 64 1)
# fi
# chpasswd <<< "${username}:${password}" 2&> /dev/null

key_file="$TYPEDAEMON_CONFIG/.typedaemon/connection_key"

if [ ! -f "$key_file" ]; then
    ssh-keygen -b 2048 -t rsa -f "$key_file" -q -N ""
fi

cat "$key_file.pub" > "${SSH_AUTHORIZED_KEYS_PATH}"
# Readable only by the owner of the config dir (the host user running `td`)
chown --reference="$TYPEDAEMON_CONFIG" "$key_file"
chmod 600 "$key_file"
mkdir -p /root/.ssh
cp "${SSH_AUTHORIZED_KEYS_PATH}" "/root/.ssh/authorized_keys"

# `td` reads this to find a way to connect. Only the keys we manage are rewritten; any others (eg a user's TD_SSH_HOST) are kept
params="$TYPEDAEMON_CONFIG/.typedaemon/connection_params"
if [ ! -f "$params" ]; then
    cat > "$params" <<'EOF'
# `td` tries, in order: the local socket, TD_SSH_HOST, then tailcat.
# Managed by TypeDaemon (rewritten on start): TD_CONNECTION_MODE, TD_TAILCAT_ADDR. Other lines are kept.
# TD_SSH_HOST=host:port   # direct SSH, when the add-on/container publishes port 7722
EOF
fi

set_param() {
    if grep -q "^$1=" "$params"; then
        sed -i "s|^$1=.*|$1=$2|" "$params"
    else
        echo "$1=$2" >> "$params"
    fi
}

set_param TD_CONNECTION_MODE SSH

# tailcat: opt-in with an `enable_tailcat` file. It reaches sshd with no open port, via a saved key so the address is stable
export XDG_CONFIG_HOME="$TYPEDAEMON_CONFIG/.typedaemon/config"
tailcat_bin="$TYPEDAEMON_MODULE/skel/bin/tailcat"
if [ -f "$TYPEDAEMON_CONFIG/.typedaemon/enable_tailcat" ] && [ -x "$tailcat_bin" ]; then
    if ! grep -q "^TD_TAILCAT_ADDR=" "$params" || [ ! -f "$XDG_CONFIG_HOME/tailcat/keys/default.private.json" ]; then
        addr="$(umask 077; "$tailcat_bin" genkey --key=default --fixed-region --force 2>/dev/null | tail -n 1)"
        case "$addr" in
            tc*) set_param TD_TAILCAT_ADDR "$addr" ;;
            *) echo "init-ssh: failed to generate a tailcat key" >&2 ;;
        esac
    fi
else
    sed -i "/^TD_TAILCAT_ADDR=/d" "$params"
fi

# Sets up the authorized SSH keys
# if bashio::config.has_value 'ssh.authorized_keys'; then
#     while read -r key; do
#         echo "${key}" >> "${SSH_AUTHORIZED_KEYS_PATH}"
#     done <<< "$(bashio::config 'ssh.authorized_keys')"
# fi

# SFTP access
# sed -i '/Subsystem sftp/s/^#//g' "${SSH_CONFIG_PATH}"

# Set (or append, if absent) a directive in sshd_config. Stock sshd_config ships these commented-out
set_sshd_option() {
    if grep -qE "^#?[[:space:]]*$1[[:space:]]" "${SSH_CONFIG_PATH}"; then
        sed -i -E "s|^#?[[:space:]]*$1[[:space:]].*|$1 $2|" "${SSH_CONFIG_PATH}"
    else
        echo "$1 $2" >> "${SSH_CONFIG_PATH}"
    fi
}

set_sshd_option Port 7722
set_sshd_option PermitRootLogin yes
set_sshd_option AllowAgentForwarding yes
set_sshd_option GatewayPorts yes
set_sshd_option AllowTcpForwarding yes
# sshd listens on all interfaces (port 7722), so only key auth is allowed - the authorized key is `.typedaemon/connection_key`
set_sshd_option PasswordAuthentication no
