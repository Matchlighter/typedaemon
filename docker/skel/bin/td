#!/bin/bash

find_config_path() {
  if [ $1 "$2" ]; then
    printf '%s\n' "${PWD%/}/$2"
  elif [ "$PWD" = / ]; then
    false
  else
    # a subshell so that we don't affect the caller's $PWD
    (cd .. && find_config_path $1 "$2")
  fi
}

find_config_file() {
  find_config_path -f "$1"
}

conn_params="$(find_config_file .typedaemon/connection_params)"

source "$conn_params"

if [ "$TD_CONNECTION_MODE" = "SSH" ]; then
  local_bin="$(find_config_path -d .typedaemon/bin)"

  config_dir="$(dirname $conn_params)"
  root_dir="$(dirname $config_dir)"
  key_file="$(mktemp)"
  socket="$(find_config_path -S .typedaemon/ssh_sock)"

  ssh_args=(-q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i "$key_file")
  [ -t 0 ] && ssh_args=(-t "${ssh_args[@]}")

  # A binary from PATH, else the one TypeDaemon shipped in .typedaemon/bin
  find_bin() {
    command -v "$1" || { [ -x "$local_bin/$1" ] && echo "$local_bin/$1"; }
  }

  # Each `via_*` adds the ssh args needed to reach sshd and succeeds, or fails if that route is unavailable
  tried=()

  # Local unix socket - the container's host
  via_socket() {
    [ -S "$socket" ] || { tried+=("socket (.typedaemon/ssh_sock not found)"); return 1; }
    local socat; socat="$(find_bin socat)" || { tried+=("socket (socat not installed)"); return 1; }
    # A stale socket file remains after the container stops, so test the connection
    "$socat" -u /dev/null UNIX-CONNECT:"$socket" > /dev/null 2>&1 || { tried+=("socket (container not accepting connections)"); return 1; }
    ssh_args+=(-o ProxyCommand="$socat - UNIX-CLIENT:$socket" root@td)
  }

  # Direct TCP to a published port 7722 - TD_SSH_HOST=host:port
  via_tcp() {
    [ -n "$TD_SSH_HOST" ] || return 1
    local host="${TD_SSH_HOST%:*}" port="${TD_SSH_HOST##*:}"
    host="${host#[}"; host="${host%]}"
    local limit=""; command -v timeout > /dev/null && limit="timeout 3"
    $limit bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" > /dev/null 2>&1 || { tried+=("tcp $TD_SSH_HOST (unreachable)"); return 1; }
    ssh_args+=(-p "$port" "root@$host")
  }

  # tailcat tunnel (no open port) - TD_TAILCAT_ADDR=<tailcat address>
  via_tailcat() {
    [ -n "$TD_TAILCAT_ADDR" ] || return 1
    local tailcat; tailcat="$(find_bin tailcat)" && "$tailcat" --help > /dev/null 2>&1 || { tried+=("tailcat (not installed; see https://github.com/tailscale/tailcat)"); return 1; }
    ssh_args+=(-o ProxyCommand="$tailcat $TD_TAILCAT_ADDR ${TD_SSH_PORT:-7722}" root@td)
  }

  via_socket || via_tcp || via_tailcat || {
    >&2 echo "Unable to connect to TypeDaemon. Tried:"
    for t in "${tried[@]}"; do >&2 echo "  - $t"; done
    [ ${#tried[@]} -eq 0 ] && >&2 echo "  (nothing is configured; see $conn_params)"
    exit 1
  }

  # SSH has a lot of bloat for this use case. I wanted to find something simpler, but nothing I could find "just worked" as well at runtime

  cat "$(find_config_file .typedaemon/connection_key)" > "$key_file"
  chmod 700 "$key_file"

  mapped_path="$($local_bin/mappath.py "$root_dir" "$PWD")"

  if [ "$1" = "shell" ]; then
    exec ssh "${ssh_args[@]}" 'cd $TYPEDAEMON_CONFIG/'$mapped_path'; exec "$SHELL" -l'
  elif [ "$1" = "run" ]; then
    >&2 echo "TypeDaemon is configured to run in Docker and cannot be started with 'td run'"
    exit 1
  elif [ "$1" = "exec" ]; then
    shift
    exec ssh "${ssh_args[@]}" 'cd $TYPEDAEMON_CONFIG/'$mapped_path'; exec' "$@"
  else
    exec ssh "${ssh_args[@]}" 'cd $TYPEDAEMON_CONFIG/'$mapped_path'; exec "td"' "$@"
  fi
elif [ "$TD_CONNECTION_MODE" = "DOCKER" ]; then
  exec docker run --rm -it -v $PWD:/config typedaemon td "$@"
elif [ -x "$(command -v td)" ]; then
  exec td "$@"
fi
