{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@protocol": ["../src/dashboard/protocol.ts"] }
  },
  "include": ["src", "vite.config.ts", "../src/dashboard/protocol.ts"]
}
